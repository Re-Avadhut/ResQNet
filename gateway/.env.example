PYTHONUNBUFFERED=1

# FastAPI / WebSocket server
HOST=0.0.0.0
PORT=8000

# Database (SQLite initially; replace DB_URL for PostgreSQL)
DATABASE_URL=sqlite:///./resqnet.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost/resqnet

# Node registration
NODE_TIMEOUT_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=10
MAX_NODES=50

# Security
SECRET_KEY=your-secret-key-change-this

# Optional: External services
GPS_PROVIDER=mock
sensor_aggregation_url=http://localhost:8080
