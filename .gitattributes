# Normalise line endings across the team.
#
# We develop on Windows but the gateway runs on Raspberry Pi OS (Linux). A
# shell script checked out with Windows line endings fails there with
#   /bin/bash^M: bad interpreter: No such file or directory
# These rules make sure that cannot happen regardless of anyone's Git settings.

# Let Git decide what is text, and store text as LF in the repository.
* text=auto eol=lf

# Files that MUST be LF - they are executed on Linux.
*.sh            text eol=lf
*.py            text eol=lf
Makefile        text eol=lf

# Windows-only scripts keep CRLF.
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Binary: never touch these, and do not try to diff them as text.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.db            binary
*.sqlite        binary
*.mbtiles       binary

# Generated - collapse it in pull request diffs so reviews stay readable.
frontend/css/tailwind.css   linguist-generated=true
package-lock.json           linguist-generated=true

# Vendored third-party code - not ours, exclude from language stats.
frontend/vendor/**          linguist-vendored=true
